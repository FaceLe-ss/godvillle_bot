# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=123456:ABCDEF_your_telegram_bot_token

# Путь к SQLite-базе настроек пользователей
DB_PATH=data/bot.db

# Базовый URL Годвилля (по умолчанию https://godville.net)
GODVILLE_BASE_URL=https://godville.net

# Интервал опроса API в секундах (рекомендуется не меньше 60, т.к. сервер обновляет данные 1 раз в минуту)
POLL_INTERVAL_SECONDS=60

# Таймаут HTTP-запросов к API Годвилля (в секундах)
REQUEST_TIMEOUT_SECONDS=15

# Опционально: ограничить доступ к боту только указанными Telegram user ID (через запятую)
# Оставьте пустым, чтобы ботом могли пользоваться все
ALLOWED_TELEGRAM_IDS=

# HTTPS URL вашего Telegram Mini App (GitHub Pages или домен вашего сервера/Cloudflare Worker)
# Например: https://username.github.io/godville-boss-bot/
WEBAPP_URL=

# Порт встроенного HTTP-сервера Mini App и /health (0 чтобы отключить)
WEBAPP_PORT=8080

# Опционально: стартовые значения для автоподсказки или быстрого импорта
# DEFAULT_GOD_NAME=
# DEFAULT_GODVILLE_TOKEN=
